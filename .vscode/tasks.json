{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run Flutter on Chrome",
			"type": "shell",
			"command": "flutter",
			"args": [
				"run",
				"-d",
				"chrome",
				"--no-web-resources-cdn"
			],
			"isBackground": true,
			"problemMatcher": [
				"$dart-flutter"
			],
			"group": "build"
		}
	]
}